---
import { SITE } from "../../site.config.mjs";

const currentYear = new Date().getUTCFullYear();
const footerLinkClass =
  "inline-flex min-h-6 items-center font-medium decoration-foreground/30 underline-offset-4 transition-colors hover:text-foreground hover:underline focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground/70";
---

<div class="bg-site-canvas pt-20 sm:pt-24">
  <footer class="bg-site-panel">
    <div class="mx-auto w-full max-w-4xl px-6 py-14 sm:px-8 sm:py-16">
      <a
        href="/"
        aria-label={`${SITE.name} home`}
        class="inline-block rounded-sm font-heading text-4xl leading-none tracking-[-0.04em] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground/70 sm:text-5xl"
      >
        {SITE.name}
      </a>

      <p class="mt-4 max-w-sm leading-relaxed text-muted-foreground">
        Our honest take on places around Bali, based on firsthand experience.
      </p>

      <dl class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
        <div>
          <dt
            class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted-foreground uppercase"
          >
            Instagram
          </dt>
          <dd class="mt-2">
            <a
              href="https://www.instagram.com/bali.approved/"
              target="_blank"
              rel="noopener noreferrer"
              class={footerLinkClass}
            >
              @bali.approved
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>

        <div>
          <dt
            class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted-foreground uppercase"
          >
            Reviews by
          </dt>
          <dd class="mt-2 flex flex-col items-start gap-1">
            <a
              href="https://www.instagram.com/lifeisshorj/"
              target="_blank"
              rel="noopener noreferrer"
              class={footerLinkClass}
            >
              @lifeisshorj
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a
              href="https://shorj.com/"
              target="_blank"
              rel="noopener noreferrer"
              class={footerLinkClass}
            >
              shorj.com
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>

        <div>
          <dt
            class="text-[0.6875rem] font-semibold tracking-[0.16em] text-muted-foreground uppercase"
          >
            WhatsApp
          </dt>
          <dd class="mt-2">
            <a
              href="https://wa.me/6285117325144"
              target="_blank"
              rel="noopener noreferrer"
              class={footerLinkClass}
            >
              +62 851-1732-5144
              <span class="sr-only"> (opens in a new tab)</span>
            </a>
          </dd>
        </div>
      </dl>

      <div
        class="mt-12 flex flex-col items-start gap-2 text-[0.6875rem] font-semibold tracking-[0.16em] text-muted-foreground uppercase md:flex-row md:items-baseline md:justify-between"
      >
        <a
          href="/"
          class="rounded-sm underline-offset-4 hover:text-foreground hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground/70"
        >
          baliapproved.id
        </a>
        <p>&copy; {currentYear} {SITE.name}</p>
      </div>
    </div>
  </footer>
</div>

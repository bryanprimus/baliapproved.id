---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  place: CollectionEntry<"places">;
}

const { place } = Astro.props;
const hasContent = Boolean(place.body?.trim());
const { Content } = await render(place);
---

{
  hasContent && (
    <div class="px-6 pb-12 sm:px-8 sm:pb-14">
      <div class="mx-auto w-full max-w-[52rem]">
        <div class="w-full text-left text-foreground [&>h1]:mt-14 [&>h1]:font-heading [&>h1]:text-2xl [&>h1]:leading-tight [&>h1]:tracking-[-0.02em] sm:[&>h1]:mt-20 sm:[&>h1]:text-[2rem] [&>h1+h2]:mt-3 [&>h1+p:has(img)]:mt-6 [&>h1+p:has(img)]:block sm:[&>h1+p:has(img)]:mt-8 [&>h1+p>img]:aspect-[2/1] [&>h2]:mt-8 [&>h2]:font-heading [&>h2]:text-xl [&>h2]:leading-snug [&>h2]:tracking-[-0.01em] sm:[&>h2]:mt-10 [&>h2+h3]:mt-4 [&>h2+p]:mt-4 [&>h2+p:has(>strong)]:font-heading [&>h2+p:has(>strong)]:text-2xl [&>h2+p:has(>strong)]:text-foreground sm:[&>h2+p:has(>strong)]:text-[1.75rem] [&>h2+ul]:mt-4 [&>h3]:mt-8 [&>h3]:text-xs [&>h3]:font-semibold [&>h3]:tracking-[0.18em] [&>h3]:text-muted-foreground [&>h3]:uppercase [&>h3+p]:mt-2 [&>h3+p]:font-heading [&>h3+p]:text-2xl [&>h3+p]:text-foreground sm:[&>h3+p]:text-[1.75rem] [&>p]:text-[0.9375rem] [&>p]:leading-[1.75] [&>p]:text-pretty [&>p]:text-muted-foreground sm:[&>p]:text-base [&>p+p]:mt-4 [&>p+ul]:mt-4 [&>p:first-child]:font-heading [&>p:first-child]:text-lg [&>p:first-child]:leading-relaxed [&>p:first-child]:tracking-[-0.01em] [&>p:first-child]:text-foreground sm:[&>p:first-child]:text-xl [&>p:first-child+p]:mt-5 [&>p:has(img)]:mt-8 [&>p:has(img)]:grid [&>p:has(img)]:grid-cols-2 [&>p:has(img)]:gap-3 sm:[&>p:has(img)]:mt-10 sm:[&>p:has(img)]:gap-4 [&>p>img]:aspect-[4/5] [&>p>img]:w-full [&>p>img]:object-cover [&>p>strong]:font-semibold [&>p>strong]:text-foreground [&>ul]:flex [&>ul]:list-none [&>ul]:flex-wrap [&>ul]:gap-2 [&>ul]:p-0 [&>ul+p]:mt-4 [&>ul>li]:rounded-full [&>ul>li]:border [&>ul>li]:border-foreground/15 [&>ul>li]:bg-foreground/5 [&>ul>li]:px-3.5 [&>ul>li]:py-2 [&>ul>li]:text-sm [&>ul>li]:font-medium sm:[&>ul>li]:px-4 sm:[&>ul>li]:text-[0.9375rem]">
          <Content />
        </div>
      </div>
    </div>
  )
}

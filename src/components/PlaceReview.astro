---
import { render, type CollectionEntry } from "astro:content";

interface Props {
  place: CollectionEntry<"places">;
}

const { place } = Astro.props;
const hasContent = Boolean(place.body?.trim());
const { Content } = await render(place);
---

{
  hasContent && (
    <div class="px-6 pb-12 sm:px-8 sm:pb-14">
      <div class="mx-auto w-full max-w-[52rem]">
        <div class="w-full text-left text-foreground [&>h2]:mt-8 [&>h2]:font-heading [&>h2]:text-xl [&>h2]:leading-snug [&>h2]:tracking-[-0.01em] sm:[&>h2]:mt-10 [&>h2+ul]:mt-4 [&>p]:text-[0.9375rem] [&>p]:leading-[1.75] [&>p]:text-pretty [&>p]:text-muted-foreground sm:[&>p]:text-base [&>p+p]:mt-4 [&>p:first-child]:font-heading [&>p:first-child]:text-lg [&>p:first-child]:leading-relaxed [&>p:first-child]:tracking-[-0.01em] [&>p:first-child]:text-foreground sm:[&>p:first-child]:text-xl [&>p>strong]:font-semibold [&>p>strong]:text-foreground [&>ul]:flex [&>ul]:list-none [&>ul]:flex-wrap [&>ul]:gap-2 [&>ul]:p-0 [&>ul>li]:rounded-full [&>ul>li]:border [&>ul>li]:border-foreground/15 [&>ul>li]:bg-foreground/5 [&>ul>li]:px-3.5 [&>ul>li]:py-2 [&>ul>li]:text-sm [&>ul>li]:font-medium sm:[&>ul>li]:px-4 sm:[&>ul>li]:text-[0.9375rem]">
          <Content />
        </div>
      </div>
    </div>
  )
}

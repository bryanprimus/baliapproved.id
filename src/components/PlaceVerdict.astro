---
import type { CollectionEntry } from "astro:content";

interface Props {
  place: CollectionEntry<"places">;
}

const { place } = Astro.props;
const { data } = place;
---

<div class="px-6 pb-12 sm:px-8 sm:pb-14">
  <div class="mx-auto w-full max-w-[52rem]">
    <div
      class="grid gap-8 border-t border-foreground/15 pt-8 sm:grid-cols-[auto_minmax(0,1fr)] sm:gap-12 sm:pt-10"
    >
      <div>
        <h3
          class="text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase"
        >
          Overall
        </h3>
        <p
          class="mt-2 flex items-baseline gap-2 font-heading text-[2.5rem] leading-none tracking-tight sm:text-5xl"
        >
          <span aria-hidden="true" class="text-2xl text-[#d49b20] sm:text-3xl"
            >★</span
          >
          <span>{data.overallRating.toFixed(1)} / 5</span>
        </p>
      </div>

      <div>
        <h3
          class="text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase"
        >
          One-line verdict
        </h3>
        <blockquote
          class="mt-2 font-heading text-lg leading-relaxed tracking-[-0.01em] text-pretty sm:text-xl"
        >
          {data.description}
        </blockquote>
      </div>
    </div>
  </div>
</div>

---
import { getCollection, type CollectionEntry } from "astro:content";

import { Seal } from "@/components/Seal";

import "../../styles/global.css";

export async function getStaticPaths() {
  if (import.meta.env.PROD) {
    return [];
  }

  const places = await getCollection("places");
  return places.map((place) => ({
    params: { id: place.id },
    props: { place },
  }));
}

interface Props {
  place: CollectionEntry<"places">;
}

if (import.meta.env.PROD) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}

const { id } = Astro.params;
const { place } = Astro.props;

if (!id) {
  throw new Error("Missing place id.");
}

const rawSrc = `/_ig-raw/${id}.jpg`;
const photoPositions: Record<string, string> = {
  starbucks_dewata: "72% 42%",
  chagee_discovery_mall: "50% 50%",
  seniman_coffee_renon: "50% 46%",
};
const photoPosition = photoPositions[id] ?? "center";
const { data } = place;
const approvedDate = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
}).format(data.approvedAt);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1080" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="light" />
    <title>IG cover · {data.title}</title>
    <style is:global>
      astro-dev-toolbar {
        display: none !important;
      }
    </style>
  </head>
  <body>
    <main class="slide">
      <div class="seal">
        <Seal
          number={data.approvalNumber}
          area={data.sealArea}
          year={data.approvedAt.getUTCFullYear()}
          size={200}
          className="bg-[#006241] [&_svg_text]:fill-white/80 [&_svg_text]:text-[13px] [&>span]:text-white"
        />
      </div>

      <h1>{data.title}</h1>

      <p class="location">📍 {data.address}</p>

      <img
        src={rawSrc}
        alt={data.coverAlt}
        class="photo"
        style={`object-position: ${photoPosition}`}
      />

      <dl class="stats">
        <div>
          <dt>Overall</dt>
          <dd>
            <span class="star" aria-hidden="true">★</span>
            <span>{data.overallRating.toFixed(1)} / 5</span>
          </dd>
        </div>
        <div>
          <dt>Spending</dt>
          <dd>{data.spending}</dd>
        </div>
        <div>
          <dt>Approved at</dt>
          <dd>
            <time datetime={data.approvedAt.toISOString()}>{approvedDate}</time>
          </dd>
        </div>
      </dl>
    </main>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 1080px;
    height: 1440px;
    overflow: hidden;
    background: var(--site-canvas);
    color: var(--foreground);
  }

  .slide {
    box-sizing: border-box;
    display: flex;
    width: 1080px;
    height: 1440px;
    flex-direction: column;
    justify-content: center;
    padding: 44px 48px 40px;
  }

  .seal {
    display: flex;
    flex: 0 0 auto;
    justify-content: center;
  }

  .seal :global([data-slot="seal"] svg) {
    animation: none !important;
  }

  h1 {
    margin: 22px 0 0;
    font-size: 64px;
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-align: center;
    text-wrap: balance;
  }

  .location {
    margin: 16px 0 0;
    font-size: 28px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--muted-foreground);
    text-align: center;
    text-wrap: pretty;
  }

  .photo {
    display: block;
    flex: 0 0 680px;
    width: 100%;
    height: 680px;
    margin-top: 28px;
    object-fit: cover;
  }

  .stats {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: 1fr 1.25fr 1fr;
    gap: 16px;
    margin-top: 28px;
    text-align: center;
  }

  .stats dt {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-foreground);
  }

  .stats dd {
    margin: 8px 0 0;
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .stats dd .star {
    margin-right: 0.3em;
    color: #d49b20;
  }
</style>

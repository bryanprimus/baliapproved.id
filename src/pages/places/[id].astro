---
import { getImage } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";

import Footer from "@/components/Footer.astro";
import { ModeToggle } from "@/components/ModeToggle";
import PlaceCover from "@/components/PlaceCover.astro";
import PlaceReview from "@/components/PlaceReview.astro";
import Layout from "@/layouts/Layout.astro";

import { SITE } from "../../../site.config.mjs";

export async function getStaticPaths() {
  const places = await getCollection("places");

  return places.map((place) => ({
    params: { id: place.id },
    props: { place },
  }));
}

interface Props {
  place: CollectionEntry<"places">;
}

const { place } = Astro.props;
const { data } = place;
const siteUrl = new URL("/", Astro.site ?? SITE.url);
const placeUrl = new URL(`/places/${place.id}`, siteUrl);
const organizationId = new URL("#organization", siteUrl).href;
const businessId = new URL("#business", placeUrl).href;
const reviewId = new URL("#review", placeUrl).href;
const socialImage = await getImage({
  src: data.cover,
  width: 1200,
  height: 630,
  fit: "cover",
  format: "webp",
});
const socialImageUrl = new URL(socialImage.src, siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      url: siteUrl.href,
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo-512.png", siteUrl).href,
        width: 512,
        height: 512,
      },
      sameAs: ["https://www.instagram.com/bali.approved/"],
    },
    {
      "@type": "CafeOrCoffeeShop",
      "@id": businessId,
      name: data.title,
      url: placeUrl.href,
      sameAs: data.mapsUrl,
      image: socialImageUrl,
      priceRange: data.spending,
      review: { "@id": reviewId },
      address: data.address,
    },
    {
      "@type": "Review",
      "@id": reviewId,
      url: placeUrl.href,
      name: `${data.title} review`,
      reviewBody: data.description,
      datePublished: data.approvedAt.toISOString().slice(0, 10),
      author: { "@id": organizationId },
      publisher: { "@id": organizationId },
      itemReviewed: { "@id": businessId },
      reviewRating: {
        "@type": "Rating",
        ratingValue: data.overallRating,
        bestRating: 5,
        worstRating: 1,
      },
    },
  ],
};
---

<Layout
  title={`${data.title} | Bali Approved`}
  description={data.description}
  canonical={placeUrl}
  image={socialImageUrl}
  imageAlt={data.coverAlt}
  type="article"
  jsonLd={jsonLd}
>
  <main class="min-h-[100dvh] bg-site-canvas">
    <div class="px-6 pt-6 sm:px-8 sm:pt-8">
      <div
        class="mx-auto flex w-full max-w-[52rem] flex-wrap items-center justify-center gap-3"
      >
        <nav aria-label="Places">
          <a
            href="/#places"
            class="group inline-flex items-center gap-2 rounded-4xl border border-foreground/20 bg-site-panel px-3.5 py-2 text-sm font-semibold transition-colors hover:border-[#006241] hover:bg-[#006241] hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#006241]"
          >
            <span
              aria-hidden="true"
              class="motion-safe:transition-transform motion-safe:group-hover:-translate-x-0.5"
            >
              ←
            </span>
            Back to places
          </a>
        </nav>

        <ModeToggle client:load />
      </div>
    </div>

    <article aria-labelledby={`${place.id}-title`}>
      <PlaceCover place={place} headingLevel="h1" />
      <PlaceReview place={place} />
    </article>
  </main>

  <Footer />
</Layout>

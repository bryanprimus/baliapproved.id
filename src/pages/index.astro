---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import PlaceCover from "@/components/PlaceCover.astro";
import PlaceReview from "@/components/PlaceReview.astro";
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";

import { SITE } from "../../site.config.mjs";

const siteUrl = new URL("/", Astro.site ?? SITE.url);
const organizationId = new URL("#organization", siteUrl).href;
const websiteId = new URL("#website", siteUrl).href;
const webpageId = new URL("#webpage", siteUrl).href;
const placesListId = new URL("#approved-places", siteUrl).href;

const places = (await getCollection("places")).sort(
  (a, b) => a.data.approvalNumber - b.data.approvalNumber,
);

const schemaImageUrls = new Map(
  await Promise.all(
    places.map(async (place) => {
      const cover = await getImage({
        src: place.data.cover,
        width: 1280,
        format: "webp",
      });

      return [place.id, new URL(cover.src, siteUrl).href] as const;
    }),
  ),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": websiteId,
      url: siteUrl.href,
      name: SITE.name,
      alternateName: "baliapproved.id",
      description: SITE.description,
      inLanguage: SITE.language,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      url: siteUrl.href,
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo-512.png", siteUrl).href,
        width: 512,
        height: 512,
      },
      sameAs: ["https://www.instagram.com/bali.approved/"],
    },
    {
      "@type": "CollectionPage",
      "@id": webpageId,
      url: siteUrl.href,
      name: SITE.title,
      description: SITE.description,
      inLanguage: SITE.language,
      isPartOf: { "@id": websiteId },
      about: places.map((place) => ({
        "@id": new URL(`#business-${place.id}`, siteUrl).href,
      })),
      mainEntity: { "@id": placesListId },
    },
    {
      "@type": "ItemList",
      "@id": placesListId,
      name: "Bali Approved places",
      numberOfItems: places.length,
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: places.map((place, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@id": new URL(`#business-${place.id}`, siteUrl).href,
        },
      })),
    },
    ...places.flatMap((place) => {
      const placeUrl = new URL(`#${place.id}`, siteUrl).href;
      const businessId = new URL(`#business-${place.id}`, siteUrl).href;
      const reviewId = new URL(`#review-${place.id}`, siteUrl).href;
      const schemaImageUrl = schemaImageUrls.get(place.id);

      if (!schemaImageUrl) {
        throw new Error(`Schema image is missing for ${place.id}.`);
      }

      return [
        {
          "@type": "CafeOrCoffeeShop",
          "@id": businessId,
          name: place.data.title,
          url: placeUrl,
          sameAs: place.data.mapsUrl,
          image: schemaImageUrl,
          priceRange: place.data.spending,
          review: { "@id": reviewId },
          address: place.data.address,
        },
        {
          "@type": "Review",
          "@id": reviewId,
          url: placeUrl,
          name: `${place.data.title} review`,
          reviewBody: place.data.description,
          datePublished: place.data.approvedAt.toISOString().slice(0, 10),
          author: { "@id": organizationId },
          publisher: { "@id": organizationId },
          itemReviewed: { "@id": businessId },
          reviewRating: {
            "@type": "Rating",
            ratingValue: place.data.overallRating,
            bestRating: 5,
            worstRating: 1,
          },
        },
      ];
    }),
  ],
};
---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <main class="min-h-[100dvh] bg-[#F5F2E9] dark:bg-[#1A1914]">
    <Hero />
    <div id="places">
      {
        places.map((place) => (
          <article
            id={place.id}
            aria-labelledby={`${place.id}-title`}
            class="scroll-mt-6"
          >
            <PlaceCover place={place} />
            <PlaceReview place={place} />
          </article>
        ))
      }
    </div>
  </main>
</Layout>

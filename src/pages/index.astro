---
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/Hero.astro";
import { Seal } from "@/components/Seal";

import { SITE } from "../../site.config.mjs";

const siteUrl = new URL("/", Astro.site ?? SITE.url);
const organizationId = new URL("#organization", siteUrl).href;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("#website", siteUrl).href,
      url: siteUrl.href,
      name: SITE.name,
      alternateName: "baliapproved.id",
      description: SITE.description,
      inLanguage: SITE.language,
      publisher: { "@id": organizationId },
    },
    {
      "@type": "Organization",
      "@id": organizationId,
      url: siteUrl.href,
      name: SITE.name,
      logo: {
        "@type": "ImageObject",
        url: new URL("/logo-512.png", siteUrl).href,
        width: 512,
        height: 512,
      },
      sameAs: ["https://www.instagram.com/bali.approved/"],
    },
  ],
};
---

<Layout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  <main class="min-h-screen bg-[#F5F2E9] dark:bg-[#1A1914]">
    <Hero />
    <div class="mx-auto flex w-full max-w-xl justify-center px-6 pb-12">
      <Seal
        number={1}
        area="Bali"
        year={2026}
        size={200}
        className="bg-[#006241] [&_svg_text]:fill-white/80 [&>span]:text-white"
      />
    </div>
  </main>
</Layout>

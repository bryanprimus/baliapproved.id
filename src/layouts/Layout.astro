---
import SEO from "@/components/SEO.astro";
import "../styles/global.css";

import { SITE } from "../../site.config.mjs";

type JsonLd = Record<string, unknown> | Record<string, unknown>[];

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  image?: string | URL;
  imageAlt?: string;
  type?: "website" | "article";
  jsonLd?: JsonLd;
}

const { title, description, jsonLd, ...seoProps } = Astro.props;
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Runs before first paint so the theme never flashes. */}
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const applyThemePreference = () => {
        const isDark = getThemePreference() === "dark";
        document.documentElement.classList[isDark ? "add" : "remove"]("dark");
      };

      applyThemePreference();

      // Only takes effect while no explicit choice is stored, so the OS
      // switching themes is followed live without overriding the user.
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", applyThemePreference);
    </script>
    <SEO title={title} description={description} {...seoProps} />
    {
      serializedJsonLd && (
        <script
          type="application/ld+json"
          set:html={serializedJsonLd}
          is:inline
        />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
